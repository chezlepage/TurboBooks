# Copy to .env and fill in.

# First admin account, created on first start only (when no users exist).
# You can remove these lines after the first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install command (the long token).
CLOUDFLARE_TUNNEL_TOKEN=

# Where audio files live on the VM. Defaults to ./library next to docker-compose.yml.
# LIBRARY_PATH=/srv/audiobooks

# Keep true when served over HTTPS (Cloudflare). Set false only for plain-http LAN testing.
COOKIE_SECURE=true

# Optional
# SESSION_DAYS=60
# SCAN_INTERVAL_MINUTES=30
# LOG_LEVEL=info

# Request books from inside TurboBooks via Shelfarr (optional).
# Shelfarr > Profile > API tokens: create one with scopes search, requests read, requests write.
# SHELFARR_URL=http://192.168.40.212:5056
# SHELFARR_TOKEN=

# Send to Kindle (optional): an email account TurboBooks sends ebooks from.
# Step-by-step (Gmail app password etc.): docs/KINDLE.md
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ourturbobooks@gmail.com
# SMTP_PASS=
# SMTP_FROM=TurboBooks <ourturbobooks@gmail.com>

# Ebook -> audiobook (optional). Claude prepares the text; Kokoro (GPU container) reads it.
# ANTHROPIC_API_KEY=
# KOKORO_URL=http://kokoro:8880
# CONVERT_MONTHLY_BUDGET_USD=100
# CONVERT_USE_BATCH=true

# Read along (optional): Whisper speech recognition lines ebook text up with audiobooks.
# docker-compose.shared-tunnel.yml runs it and points here by default; leave empty to turn it off.
# WHISPER_URL=http://whisper:9000
