# Copy to .env and fill in.

# First admin account, created on first start only (when no users exist).
# You can remove these lines after the first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install command (the long token).
CLOUDFLARE_TUNNEL_TOKEN=

# Where audio files live on the VM. Defaults to ./library next to docker-compose.yml.
# LIBRARY_PATH=/srv/audiobooks

# Keep true when served over HTTPS (Cloudflare). Set false only for plain-http LAN testing.
COOKIE_SECURE=true

# Optional
# SESSION_DAYS=60
# SCAN_INTERVAL_MINUTES=30
# LOG_LEVEL=info
